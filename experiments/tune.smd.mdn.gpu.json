{
  "name": "smd-mdn-tuning-gpu",
  "jobs": [
    {
      "run_id": "smd-mdn-tune-base-gpu",
      "pipeline": "smd-mdn",
      "dataset": "smd",
      "notes": "Selected-machine calibrated MDN-LSTM baseline for tuning",
      "params": {
        "root": "datasets/SMD",
        "machine_ids": ["machine-1-1", "machine-1-2", "machine-1-3"],
        "validation_fraction": 0.2,
        "lookback": 100,
        "horizon": 1,
        "stride": 4,
        "hidden_size": 64,
        "num_layers": 1,
        "n_components": 3,
        "epochs": 3,
        "batch_size": 128,
        "learning_rate": 0.001,
        "energy_samples": 16,
        "seed": 902,
        "device": "cuda",
        "anomaly_score_method": "channel_max_nll",
